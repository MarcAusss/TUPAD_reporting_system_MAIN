APP_NAME="TUPAD Reporting System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tupad_reporting
DB_USERNAME=tupad_app
DB_PASSWORD=CHANGE_ME

# Database-backed sessions/cache/queues are suitable for a single-server deployment.
# If Redis is later enabled, change these three values together after testing.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis is optional. Do not use REDIS_CLIENT=phpredis unless the PHP Redis extension is installed.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Replace with the actual production mail transport when email delivery is required.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TUPAD operational dashboard prioritization only; these are not statutory deadlines.
TUPAD_DASHBOARD_ATTENTION_DAYS=7
TUPAD_DASHBOARD_CRITICAL_DAYS=14

# Official report document control and current authorized signatories.
TUPAD_REPORT_VERSION=1.0
TUPAD_REPORT_REVISION=0
TUPAD_REPORT_CLASSIFICATION="Internal Government Report"
TUPAD_REPORT_REFERENCE_PREFIX=DOLE-RO5-TUPAD
TUPAD_REPORT_OFFICE="Department of Labor and Employment - Regional Office V"
TUPAD_REPORT_TIMEZONE=Asia/Manila
TUPAD_REPORT_PREPARED_BY_NAME=
TUPAD_REPORT_PREPARED_BY_POSITION=
TUPAD_REPORT_PREPARED_BY_OFFICE=
TUPAD_REPORT_REVIEWED_BY_NAME=
TUPAD_REPORT_REVIEWED_BY_POSITION=
TUPAD_REPORT_REVIEWED_BY_OFFICE=
TUPAD_REPORT_APPROVED_BY_NAME=
TUPAD_REPORT_APPROVED_BY_POSITION=
TUPAD_REPORT_APPROVED_BY_OFFICE=

# Phase 5 operations and clean-production bootstrap.
TUPAD_BACKUP_DIRECTORY=storage/app/backups/database
TUPAD_BACKUP_RETENTION_DAYS=14
TUPAD_HEALTH_MIN_FREE_MB=1024
TUPAD_HEALTH_REPORT_PATH=storage/app/health/latest.json

# Required only when the production database has no Administrator yet.
# After the first Administrator is created, these may be removed from .env.
TUPAD_INITIAL_ADMIN_NAME=
TUPAD_INITIAL_ADMIN_USERNAME=
TUPAD_INITIAL_ADMIN_EMAIL=
TUPAD_INITIAL_ADMIN_POSITION="System Administrator"

